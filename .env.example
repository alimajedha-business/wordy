# Example Environment Configuration
VITE_APP_TITLE=کلمه‌بازی
VITE_APP_NAME=kalameh-bazi
VITE_APP_VERSION=1.0.0

# Remote Server Deployment Configuration
SERVER_IP=your_server_ip
SERVER_PORT=22
SERVER_USER=root
# Provide either SERVER_PASSWORD or SERVER_SSH_KEY
SERVER_PASSWORD=your_server_password
SERVER_SSH_KEY=
# Optional: domain name if you have pointed one to the server
SERVER_DOMAIN="wordy.ir www.wordy.ir"
